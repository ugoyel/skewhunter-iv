    <string name="how_title">How ClearTether works</string>
    <string name="how_step1_title">Private Wi-Fi Direct network</string>
    <string name="how_step1_body">Your phone creates its own WPA2 Wi-Fi network. Carrier hotspot provisioning isn\'t involved.</string>
    <string name="how_step2_title">Scan, tap or install</string>
    <string name="how_step2_body">iPhones and Androids join with a QR code or NFC tap. Laptops get a one-time proxy script.</string>
    <string name="how_step3_title">Corporate-safe</string>
    <string name="how_step3_body">HTTPS is tunneled blindly, so certificates, SSL pinning and company security tools keep working.</string>
    <string name="how_step4_title">Transparent on Android</string>
    <string name="how_step4_body">Android devices running ClearTether in \"Use internet\" mode need no proxy setup at all.</string>
