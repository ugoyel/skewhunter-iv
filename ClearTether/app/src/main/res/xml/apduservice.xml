<?xml version="1.0" encoding="utf-8"?>
<!-- NFC Forum Type 4 Tag (NDEF) emulation. requireDeviceUnlock keeps the Wi-Fi password
     from being read off a locked phone in a pocket. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/nfc_service_description"
    android:requireDeviceUnlock="true">
    <aid-group
        android:category="other"
        android:description="@string/nfc_aid_description">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
