<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: Wi-Fi credentials are device-specific, the free-tier
     meter must not be restorable, and Premium is restored from Google Play instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
