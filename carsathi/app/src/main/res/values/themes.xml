<resources>
    <style name="Theme.CarSathi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/cs_white</item>
    </style>

    <style name="Theme.CarSathi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cs_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CarSathi</item>
    </style>
</resources>
